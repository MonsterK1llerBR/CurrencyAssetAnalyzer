<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0-windows</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <SupportedOSPlatformVersion>6.1</SupportedOSPlatformVersion>

        <AssemblyName>CurrencyAssetAnalyzer</AssemblyName>
        <RootNamespace>CurrencyAssetAnalyzer</RootNamespace>

        <Product>Currency Asset Analyzer</Product>
        <Description>Diagnostic tool for analyzing physical currency in Supermarket Simulator</Description>
        <Version>0.1.0</Version>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
    </PropertyGroup>

